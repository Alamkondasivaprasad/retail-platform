pipeline {
    agent any

    parameters {
        choice(
            name: 'DEPLOYMENT_ACTION',
            choices: ['DEPLOY', 'ROLLBACK'],
            description: 'Choose deployment action'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: ['UAT', 'PRODUCTION'],
            description: 'Choose environment'
        )

        string(
            name: 'VERSION',
            defaultValue: '4.2.2',
            description: 'Application version'
        )

        choice(
            name: 'CONFIRM_PROD',
            choices: ['NO', 'YES'],
            description: 'Production confirmation'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                echo "Selected Git commit:"
                bat 'git rev-parse HEAD'
            }
        }

        stage('Production Guard') {
            when {
                expression {
                    params.ENVIRONMENT == 'PRODUCTION'
                }
            }
            steps {
                script {
                    if (params.CONFIRM_PROD != 'YES') {
                        error("PRODUCTION deployment blocked: CONFIRM_PROD must be YES")
                    }
                }
            }
        }

        stage('Validate Version') {
            steps {
                echo "Environment: ${params.ENVIRONMENT}"
                echo "Action: ${params.DEPLOYMENT_ACTION}"
                echo "Version: ${params.VERSION}"

                bat "git rev-parse refs/tags/v${params.VERSION}"
            }
        }

        stage('Docker Build') {
            steps {
                echo "Building retail-app:${params.VERSION}"

                bat "\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe\" build -t retail-app:${params.VERSION} ."
            }
        }

        stage('Docker Image Check') {
            steps {
                bat "\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe\" images retail-app:${params.VERSION}"
            }
        }

        stage('Start Candidate') {
            when {
                expression {
                    params.DEPLOYMENT_ACTION == 'DEPLOY'
                }
            }
            steps {
                echo "Starting candidate version ${params.VERSION}"

                bat "\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe\" rm -f retail-app-candidate 2>NUL || exit /b 0"

                bat "\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe\" run -d --name retail-app-candidate -p 8082:80 retail-app:${params.VERSION}"
            }
        }

        stage('Health Check') {
            when {
                expression {
                    params.DEPLOYMENT_ACTION == 'DEPLOY'
                }
            }
            steps {
                script {
                    echo "Waiting for candidate health check..."

                    bat 'timeout /t 25 /nobreak'

                    def health = bat(
                        script: '@docker inspect --format="{{.State.Health.Status}}" retail-app-candidate',
                        returnStdout: true
                    ).trim()

                    echo "Candidate health status: ${health}"

                    if (!health.contains("healthy")) {
                        error("HEALTH CHECK FAILED for version ${params.VERSION}")
                    }
                }
            }
        }
    }

    post {
        failure {
            echo "DEPLOYMENT FAILED - Starting automatic rollback..."

            bat "\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe\" rm -f retail-app-candidate 2>NUL || exit /b 0"

            bat "\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe\" start retail-app-uat 2>NUL || exit /b 0"

            echo "Previous version 4.2.1 restored."

            bat "\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe\" ps"
        }

        success {
            echo "DEPLOYMENT SUCCESSFUL"
        }
    }
}
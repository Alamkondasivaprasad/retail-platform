pipeline {
    agent any

    parameters {
        choice(name: 'DEPLOYMENT_ACTION', choices: ['DEPLOY', 'ROLLBACK'], description: 'Choose deployment action')
        choice(name: 'ENVIRONMENT', choices: ['UAT', 'PRODUCTION'], description: 'Choose environment')
        string(name: 'VERSION', defaultValue: '4.2.1', description: 'Application version')
        choice(name: 'CONFIRM_PROD', choices: ['NO', 'YES'], description: 'Production confirmation')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Selected Git commit:"
                sh 'git rev-parse HEAD'
            }
        }

        stage('Validate') {
            steps {
                echo "Deployment Action: ${params.DEPLOYMENT_ACTION}"
                echo "Environment: ${params.ENVIRONMENT}"
                echo "Version: ${params.VERSION}"
            }
        }
    }
}